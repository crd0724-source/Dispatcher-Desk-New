# Supabase Configuration (Client-side / Public)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# CARTO Basemaps API Key (Client-side / Public)
VITE_CARTO_API_KEY=""

# GEMINI_API_KEY: Required for Gemini AI API calls (future phases)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# Razorpay Configuration (Server-side Only - Never expose to client)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret"

# Supabase Service Role Key (Server-side Only)
SUPABASE_SERVICE_ROLE_KEY=""
